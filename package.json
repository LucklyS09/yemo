{
  "name": "ink-nocturne",
  "version": "1.0.0",
  "private": true,
  "description": "墨夜 · 本地优先的小说创作空间：大纲、分级设定集、纯文本正文与自动词条上色。",
  "main": "electron/main.js",
  "author": "墨夜",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.inknocturne.desktop",
    "productName": "墨夜",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "墨夜-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨夜",
      "uninstallDisplayName": "墨夜"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
